# Required on Vercel for the remote MariaDB connection
DB_HOST=your-vds-ip-or-domain
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=your-database-name
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Session secret
secret=replace-with-a-long-random-session-secret

# Optional legacy names, supported for local development only:
# host=your-database-host
# user=your-database-user
# password=your-database-password
# database=your-database-name

# Required only for admin video upload/delete through SFTP
sftpHost=your-vds-host
sftpUsername=your-sftp-user
sftpPassword=your-sftp-password
videoBaseUrl=https://your-vds-domain/videos

# Vercel sets this automatically. Keep it out of local .env files.
NODE_ENV=production
